# Facebook API Configuration (Optional but Recommended)
# =====================================================
# The Facebook Catalog API provides stable, complete access to your listings.
# Scraping alone may miss items due to Facebook's lazy loading.
#
# To get these credentials:
# 1. Go to https://developers.facebook.com/
# 2. Create or select your app
# 3. Add the Marketing API product
# 4. Generate an access token with 'catalog_management' permission
# 5. Find your Catalog ID in Commerce Manager

# Your Facebook access token (from Graph API Explorer or your app)
FB_ACCESS_TOKEN=

# Your Facebook Catalog ID (from Commerce Manager)
FB_CATALOG_ID=

# When configured, the scraper will:
# 1. Try API first (complete, stable data)
# 2. Fall back to scraping if API fails
# 3. Show warning if scrape count < expected

# Without API credentials:
# - Scraping may miss listings due to lazy loading
# - Data may be incomplete on some pages
# - No stable pagination available

